# Canonical public origin of this Next.js application (no trailing slash or path).
APP_URL=http://localhost:3000

# The one PocketBase origin used by both server and browser code (no trailing slash).
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Optional credentials used by the views API.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
