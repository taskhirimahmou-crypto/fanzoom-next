# Local Docker only. Never reuse these values on staging or production.
PB_SUPERUSER_EMAIL=admin@fanzoom.local
PB_SUPERUSER_PASSWORD=LocalAdmin-Change-Me-Only
POCKETBASE_ADMIN_EMAIL=admin@fanzoom.local
POCKETBASE_ADMIN_PASSWORD=LocalAdmin-Change-Me-Only
LOCAL_TEST_USER_EMAIL=reader@fanzoom.local
LOCAL_TEST_USER_PASSWORD=LocalReader-Change-Me-Only
VIEW_RATE_LIMIT_SECRET=local-only-change-this-to-a-long-random-value
# Disabled by default. Set only after the platform confirms it overwrites a
# single-IP header and strips the same header from direct client requests.
VIEW_TRUSTED_PROXY_IP_HEADER=
FANZOOM_LOCAL_WEB_PORT=3000
FANZOOM_LOCAL_PB_PORT=8090
